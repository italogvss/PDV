</style>

<script>
  // Toggle mensal/anual dos cards de plano. Mensal → R$ x,xx/mês; Anual → total pago uma
  // vez no ano + economia, e o CTA passa a apontar para o slug do período (?plano=<slug>-anual).
  const toggle = document.getElementById('billing-toggle');
  const btns = toggle?.querySelectorAll<HTMLButtonElement>('.planos-toggle-btn');
  const cards = document.querySelectorAll<HTMLElement>('.plano');

  const setPeriod = (period: string) => {
    const isAnual = period === 'anual';
    toggle?.classList.toggle('is-anual', isAnual);
    btns?.forEach((b) => {
      const on = b.dataset.period === period;
      b.classList.toggle('active', on);
      b.setAttribute('aria-pressed', String(on));
    });
    cards.forEach((card) => {
      const amount = card.querySelector<HTMLElement>('.plano-amount');
      const mes = card.querySelector<HTMLElement>('.plano-mes');
      const economia = card.querySelector<HTMLElement>('.plano-economia');
      const cta = card.querySelector<HTMLAnchorElement>('.plano-cta');
      if (amount) {
        amount.textContent = (isAnual ? card.dataset.anual : card.dataset.mensal) ?? '';
        amount.classList.remove('flip');
        void amount.offsetWidth; // re-dispara a animação de troca
        amount.classList.add('flip');
      }
      if (mes) mes.textContent = isAnual ? '/ano' : '/mês';
      if (economia) economia.hidden = !isAnual;
      if (cta) cta.href = (isAnual ? cta.dataset.ctaAnual : cta.dataset.ctaMensal) ?? cta.href;
    });
  };

  btns?.forEach((b) => b.addEventListener('click', () => setPeriod(b.dataset.period ?? 'mensal')));
</script>
