---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CtaFinal from '../components/CtaFinal.astro';

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173';

const segmentos = [
  'Mercadinho', 'Barbearia', 'Padaria', 'Petshop', 'Loja de roupas',
  'Lanchonete', 'Salão de beleza', 'Adega', 'Farmácia', 'Papelaria',
];

const features = [
  {
    nome: 'Vendas', tag: 'PDV',
    titulo: 'Um caixa que não trava na fila',
    desc: 'Bipou, vendeu. Busca por nome ou código, desconto na hora e recibo no WhatsApp do cliente.',
    img: 'https://placehold.co/760x440/1a1916/5ee074.png?text=Tela+de+Vendas',
    size: 'lead',
    icon: '<path d="M3 11.4 11.4 3H20a1 1 0 0 1 1 1v8.6l-8.4 8.4a1.5 1.5 0 0 1-2.1 0L3 13.5a1.5 1.5 0 0 1 0-2.1Z"/><circle cx="16.4" cy="7.6" r="1.4"/>',
  },
  {
    nome: 'Estoque', tag: 'Controle',
    titulo: 'Saiba o que tem, o que falta e o que vende',
    desc: 'Baixa automática a cada venda e alerta quando o produto está acabando.',
    img: 'https://placehold.co/440x460/14a82e/eafff0.png?text=Estoque',
    size: 'tall',
    icon: '<path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/>',
  },
  {
    nome: 'Relatórios', tag: 'Analytics',
    titulo: 'Os números do seu negócio, sem planilha',
    desc: 'Quanto entrou hoje, qual produto mais vende e qual horário é mais movimentado.',
    img: 'https://placehold.co/440x240/1a1916/25cf3f.png?text=Relatorios',
    size: 'small',
    icon: '<path d="M5 19V5"/><path d="M5 19h14"/><path d="M9 19v-4.5"/><path d="M14 19v-8"/><path d="M19 19V8.5"/>',
  },
  {
    nome: 'Agenda', tag: 'Agendamentos',
    titulo: 'Horários cheios, sem caderninho',
    desc: 'Clientes marcam sozinhos e ninguém esquece o compromisso.',
    img: 'https://placehold.co/440x240/14a82e/eafff0.png?text=Agenda',
    size: 'small',
    icon: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17"/><path d="M8 3.5v3M16 3.5v3"/>',
  },
  {
    nome: 'Despesas', tag: 'Financeiro',
    titulo: 'Veja se sobra no fim do mês',
    desc: 'Lança a conta, anexa o comprovante e acompanha o lucro de verdade.',
    img: 'https://placehold.co/620x360/1a1916/5ee074.png?text=Financeiro',
    size: 'banner',
    icon: '<path d="M6 3h12v18l-2.2-1.4L13.6 21 12 19.6 10.4 21l-1.6-1.4L6 21V3Z"/><path d="M9.5 8.5h5M9.5 12.5h5"/>',
  },
];

const depoimentos = [
  {
    texto: 'Saí do caderno e da calculadora. Agora sei exatamente quanto vendi sem fazer conta de cabeça.',
    nome: 'Marcos Ribeiro', negocio: 'Mercadinho do Marcos', cidade: 'Campinas, SP',
  },
  {
    texto: 'Os clientes marcam o corte sozinhos pelo link. Minha agenda lota e eu não atendo telefone o dia todo.',
    nome: 'Diego Fontes', negocio: 'Barbearia Navalha', cidade: 'Recife, PE',
  },
  {
    texto: 'Em um mês eu vi qual produto dava prejuízo. Tirei da prateleira e o lucro subiu.',
    nome: 'Patrícia Lemos', negocio: 'Adega da Pati', cidade: 'Curitiba, PR',
  },
];

const planos = [
  {
    nome: 'Essencial', preco: '39', descricao: 'Pra quem está começando a organizar as vendas.',
    itens: ['PDV completo', 'Controle de estoque', 'Até 2 usuários'], destaque: false,
  },
  {
    nome: 'Profissional', preco: '79', descricao: 'O queridinho de quem já vende todo dia.',
    itens: ['Tudo do Essencial', 'Relatórios e analytics', 'Agenda e agendamentos', 'Até 6 usuários'], destaque: true,
  },
  {
    nome: 'Avançado', preco: '149', descricao: 'Pra operação com mais de um caixa.',
    itens: ['Tudo do Profissional', 'Múltiplas lojas', 'Usuários ilimitados'], destaque: false,
  },
];
---

<Layout
  title="Ka$hing — O PDV que faz sua loja soar cha-ching"
  description="Ponto de venda, estoque, agenda e relatórios num app só. Feito para o pequeno comércio brasileiro. 14 dias grátis, sem cartão."
>
  <Navbar />

  <main>
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">PDV + gestão pro pequeno comércio</p>
          <h1 class="hero-title">
            <span class="word" style="--wi: 0">Faça</span>{' '}
            <span class="word" style="--wi: 1">sua</span>{' '}
            <span class="word" style="--wi: 2">loja</span>{' '}
            <span class="word" style="--wi: 3">soar</span>{' '}
            <span class="word hero-chaching shimmer" style="--wi: 4">cha-ching</span>
          </h1>
          <p class="hero-sub">
            Caixa, estoque, agenda e relatórios num app só. Simples o bastante
            pro dia a dia — completo o bastante pra fazer o negócio crescer.
          </p>
          <div class="hero-actions">
            <a href={`${appUrl}/cadastro`} class="btn-brand hero-btn">Criar conta grátis</a>
            <a href="/solucoes" class="hero-secondary">Ver o que faz →</a>
          </div>
          <ul class="hero-reassure">
            <li>14 dias grátis</li>
            <li>Sem cartão</li>
            <li>Pronto em 2 minutos</li>
          </ul>
        </div>

        <div class="hero-stage">
          <div class="hero-glow" aria-hidden="true"></div>
          <img
            class="hero-shot"
            src="https://placehold.co/900x620/1a1916/5ee074.png?text=Tela+de+Vendas"
            alt="Tela de vendas do Ka$hing"
            width="900" height="620" loading="eager"
          />
          <div class="sale-chip chip-1" aria-hidden="true">
            <span class="chip-amount shimmer">+ R$ 48,00</span>
            <span class="chip-label">Venda registrada</span>
          </div>
          <div class="sale-chip chip-2" aria-hidden="true">
            <span class="chip-amount shimmer">+ R$ 12,90</span>
            <span class="chip-label">Pix recebido</span>
          </div>
          <svg class="hero-coin" viewBox="0 0 48 48" aria-hidden="true">
            <circle cx="24" cy="24" r="21" fill="var(--color-brand-dark)"/>
            <circle cx="24" cy="22.5" r="20" fill="var(--color-brand)"/>
            <circle cx="24" cy="22.5" r="20" fill="none" stroke="var(--color-brand-light)" stroke-width="1.6"/>
            <path d="M24 9 V36.5" fill="none" stroke="var(--color-surface)" stroke-width="3.2" stroke-linecap="round"/>
            <path d="M30.5 16 C30.5 12.3 27 10.9 23.4 10.9 C19.4 10.9 17 13 17 16.1 C17 19.4 20.3 20.4 24 21.4 C28 22.4 31.3 23.4 31.3 26.7 C31.3 30 28.5 31.8 24.4 31.8 C20.3 31.8 17.2 30.3 17.2 27.1"
              fill="none" stroke="var(--color-surface)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
    </section>

    <!-- ============ SEGMENTOS ============ -->
    <section class="segmentos">
      <div class="container">
        <p class="seg-lead" data-reveal>Feito pra quem vende de verdade, todo dia</p>
        <ul class="seg-list">
          {segmentos.map((s, i) => (
            <li class="seg-chip" data-reveal style={`--reveal-delay: ${i * 45}ms`}>{s}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ PROBLEMA → SOLUÇÃO ============ -->
    <section class="ps section">
      <div class="container ps-grid">
        <div class="ps-head" data-reveal>
          <p class="eyebrow">Soa familiar?</p>
          <h2 class="ps-title">Tocar um comércio não devia ser tão no escuro</h2>
          <p class="ps-text">
            Você abre a loja todo dia, mas no fim do mês a conta nunca fecha do jeito
            que devia. O Ka$hing troca o achismo por número.
          </p>
        </div>
        <div class="ps-compare">
          <div class="ps-col ps-before" data-reveal>
            <span class="ps-tag ps-tag-before">Hoje</span>
            <ul>
              <li>Venda anotada no caderno (quando dá tempo)</li>
              <li>Estoque conferido no olho</li>
              <li>Não sabe qual produto dá lucro</li>
              <li>Fim do mês é só susto</li>
            </ul>
          </div>
          <div class="ps-col ps-after" data-reveal style="--reveal-delay: 90ms">
            <span class="ps-tag ps-tag-after">Com o Ka$hing</span>
            <ul>
              <li>Toda venda registrada na hora</li>
              <li>Estoque baixa sozinho a cada venda</li>
              <li>Relatório mostra o que dá dinheiro</li>
              <li>Você sabe se sobrou — e quanto</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FEATURES (BENTO) ============ -->
    <section class="features section">
      <div class="container">
        <div class="features-head" data-reveal>
          <p class="eyebrow">Tudo num lugar só</p>
          <h2 class="features-title">Menos abas abertas. Mais loja girando.</h2>
        </div>
        <div class="bento">
          {features.map((f, i) => (
            <article class:list={['feat', `feat-${f.size}`]} data-reveal style={`--reveal-delay: ${i * 70}ms`}>
              <div class="feat-text">
                <div class="feat-head">
                  <span class="feat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
                  </span>
                  <span class="feat-tag">{f.tag}</span>
                </div>
                <h3 class="feat-title">{f.titulo}</h3>
                <p class="feat-desc">{f.desc}</p>
              </div>
              <div class="feat-shot">
                <img src={f.img} alt={`Tela de ${f.nome} do Ka$hing`} loading="lazy" />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ DEPOIMENTOS ============ -->
    <section class="depo section">
      <div class="container">
        <div class="depo-head" data-reveal>
          <p class="eyebrow">Quem já faz cha-ching</p>
          <h2 class="depo-title">Donos de verdade, contas que fecham</h2>
        </div>
        <div class="depo-grid">
          {depoimentos.map((d, i) => (
            <figure class="depo-card" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              <div class="depo-quote" aria-hidden="true">”</div>
              <blockquote>{d.texto}</blockquote>
              <figcaption>
                <span class="depo-nome">{d.nome}</span>
                <span class="depo-meta">{d.negocio} · {d.cidade}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ RESUMO DE PLANOS ============ -->
    <section class="planos section">
      <div class="container">
        <div class="planos-head" data-reveal>
          <p class="eyebrow">Cabe no caixa</p>
          <h2 class="planos-title">Um plano pra cada tamanho de loja</h2>
          <p class="planos-sub">Comece grátis. Escolha o plano só quando o teste convencer você.</p>
        </div>
        <div class="planos-grid">
          {planos.map((p, i) => (
            <article class:list={['plano', { 'plano-destaque': p.destaque }]} data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              {p.destaque && <span class="plano-badge">Mais escolhido</span>}
              <h3 class="plano-nome">{p.nome}</h3>
              <p class="plano-desc">{p.descricao}</p>
              <p class="plano-preco">
                <span class="plano-cifra">R$</span>{p.preco}<span class="plano-mes">/mês</span>
              </p>
              <ul class="plano-itens">
                {p.itens.map((i) => <li>{i}</li>)}
              </ul>
              <a href={`${appUrl}/cadastro`} class:list={['plano-cta', { 'btn-brand': p.destaque }]}>
                Começar teste grátis
              </a>
            </article>
          ))}
        </div>
        <p class="planos-link"><a href="/preco">Comparar tudo em detalhe →</a></p>
      </div>
    </section>

    <CtaFinal />
  </main>

  <Footer />
</Layout>

<style>
  /* ============ HERO ============ */
  .hero { padding-block: var(--space-10) var(--space-12); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: var(--space-10);
  }
  .hero-title {
    font-size: clamp(var(--text-5xl), 8vw, var(--text-7xl));
    letter-spacing: -0.03em;
    margin: var(--space-4) 0 var(--space-5);
  }
  /* entrada palavra a palavra no load */
  .hero-title .word {
    display: inline-block;
    animation: word-rise 0.7s var(--ease-spring) backwards;
    animation-delay: calc(120ms + var(--wi) * 70ms);
  }
  @keyframes word-rise {
    from { opacity: 0; transform: translateY(0.5em); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero-chaching {
    color: var(--color-brand-deep);
    white-space: nowrap;
    padding-bottom: 0.12em;
    /* tokens do shimmer: sheen verde-claro sobre verde profundo */
    --shimmer-base: var(--color-brand-deep);
    --shimmer-glow: #e6ffee;
    --shimmer-dur: 3.2s;
  }
  /* entra junto com as outras palavras E mantém o shimmer rodando.
     Precisa ser mais específico que `.hero-title .word`, que senão
     sobrescreveria a propriedade `animation` e travaria o shimmer. */
  .hero-title .word.hero-chaching {
    animation:
      word-rise 0.7s var(--ease-spring) calc(120ms + var(--wi) * 70ms) backwards,
      shimmer var(--shimmer-dur) linear 1s infinite;
  }
  .hero-sub {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    max-width: 32rem;
    margin-bottom: var(--space-6);
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }
  .hero-btn { padding: var(--space-4) var(--space-6); font-size: var(--text-lg); }
  .hero-secondary {
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-lg);
    color: var(--color-ink);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .hero-secondary:hover { color: var(--color-brand-deep); }
  .hero-reassure { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .hero-reassure li {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-size: var(--text-sm); color: var(--color-text-muted);
  }
  .hero-reassure li::before {
    content: '✓'; color: var(--color-brand-dark); font-weight: var(--weight-bold);
  }

  /* Hero stage com brilho e chips de venda (assinatura) */
  .hero-stage {
    position: relative;
    animation: rise var(--dur-slow) var(--ease-spring) both;
  }
  .hero-glow {
    position: absolute;
    inset: 8% 6% -6% 6%;
    background: radial-gradient(60% 60% at 50% 60%, rgba(37, 207, 63, 0.55), transparent 70%);
    filter: blur(48px);
    z-index: 0;
  }
  .hero-shot {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-glow);
    transform: rotate(-1.2deg);
  }
  .sale-chip {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }
  .chip-amount {
    font-weight: var(--weight-bold);
    font-size: var(--text-base);
    color: var(--color-brand-deep);
    --shimmer-base: var(--color-brand-deep);
    --shimmer-glow: #aef7be;
    --shimmer-dur: 3s;
  }
  .chip-label { font-size: var(--text-xs); color: var(--color-text-muted); }
  .chip-1 { top: 6%; right: -6%; animation: float 5s var(--ease-spring) infinite; }
  .chip-2 { bottom: 10%; left: -8%; animation: float 6s var(--ease-spring) infinite 0.6s; }
  .hero-coin {
    position: absolute;
    z-index: 2;
    width: 54px;
    height: 54px;
    bottom: -4%;
    right: 8%;
    filter: drop-shadow(0 8px 16px rgba(21, 168, 46, 0.4));
    animation: float 7s var(--ease-spring) infinite 0.3s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ============ SEGMENTOS ============ */
  .segmentos { padding-block: var(--space-6) var(--space-10); }
  .seg-lead {
    text-align: center;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: var(--space-5);
  }
  .seg-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  .seg-chip {
    padding: var(--space-2) var(--space-5);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-base) var(--ease-spring), border-color var(--dur-fast);
  }
  .seg-chip:hover { transform: translateY(-3px); border-color: var(--color-brand); }

  /* ============ PROBLEMA → SOLUÇÃO ============ */
  .ps-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: var(--space-10); align-items: center; }
  .ps-title { font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl)); margin: var(--space-4) 0; }
  .ps-text { font-size: var(--text-lg); color: var(--color-text-muted); max-width: 28rem; }
  .ps-compare { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .ps-col {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line);
  }
  .ps-before { background: var(--color-cloud); }
  .ps-after {
    background:
      radial-gradient(120% 120% at 100% 0%, rgba(37, 207, 63, 0.12), transparent 60%),
      var(--color-mint);
    border-color: var(--color-mint-deep);
  }
  .ps-tag {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
  }
  .ps-tag-before { background: var(--color-line-strong); color: var(--color-text-muted); }
  .ps-tag-after { background: var(--color-brand); color: var(--color-on-brand); }
  .ps-col ul { display: flex; flex-direction: column; gap: var(--space-3); }
  .ps-col li { position: relative; padding-left: var(--space-6); font-size: var(--text-base); line-height: 1.45; }
  .ps-before li { color: var(--color-text-muted); }
  .ps-before li::before {
    content: '✕'; position: absolute; left: 0; top: 0;
    color: var(--color-text-faint); font-weight: var(--weight-bold);
  }
  .ps-after li { color: var(--color-ink); }
  .ps-after li::before {
    content: '✓'; position: absolute; left: 0; top: 0;
    color: var(--color-brand-dark); font-weight: var(--weight-bold);
  }

  /* ============ FEATURES (BENTO) ============ */
  .features-head { max-width: 40rem; margin-bottom: var(--space-8); }
  .features-title { font-size: clamp(var(--text-3xl), 4.5vw, var(--text-5xl)); margin-top: var(--space-3); }
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-4);
  }
  .feat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform var(--dur-base) var(--ease-spring), box-shadow var(--dur-base) var(--ease-out);
  }
  .feat:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }

  /* posicionamento explícito do bento (grid 6 col) */
  .feat-lead   { grid-column: span 4; }
  .feat-tall   { grid-column: span 2; grid-row: span 2; }
  .feat-small  { grid-column: span 2; }
  .feat-banner { grid-column: span 6; }

  /* cards largos: texto e tela lado a lado */
  .feat-lead, .feat-banner { flex-direction: row; align-items: center; gap: var(--space-7); }
  .feat-lead .feat-text, .feat-banner .feat-text { flex: 1; }
  .feat-lead .feat-shot, .feat-banner .feat-shot { flex: 1; align-self: stretch; }

  .feat-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .feat-icon {
    display: grid;
    place-items: center;
    width: 42px;
