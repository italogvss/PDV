---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Política de Privacidade — Ka$hing"
  description="Política de Privacidade da plataforma Ka$hing."
>
  <Navbar />

  <main>
    <section class="legal">
      <div class="container legal-prose">
        <div id="legal-content" data-slug="politica-de-privacidade">
          <p class="legal-loading">Carregando…</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { marked } from 'marked';

  const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:5000/api';
  const container = document.getElementById('legal-content');
  const slug = container?.dataset.slug;

  if (container && slug) {
    fetch(`${apiUrl}/legal/${slug}`)
      .then((res) => {
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return res.json();
      })
      .then((doc: { content: string }) => {
        container.innerHTML = marked.parse(doc.content) as string;
      })
      .catch(() => {
        container.innerHTML = '<p class="legal-error">Não foi possível carregar o conteúdo agora. Tente novamente em instantes.</p>';
      });
  }
</script>

<style>
  .legal { padding-block: var(--space-10) var(--space-14); }
  .legal-prose {
    max-width: 46rem;
    margin-inline: auto;
  }
  .legal-loading,
  .legal-error {
    color: var(--color-text-muted);
  }
  .legal-prose :global(h1) {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
    margin-bottom: var(--space-3);
  }
  .legal-prose :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }
  .legal-prose :global(h3) {
    font-size: var(--text-lg);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }
  .legal-prose :global(p) {
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }
  .legal-prose :global(ul),
  .legal-prose :global(ol) {
    margin: 0 0 var(--space-4) var(--space-5);
    list-style: revert;
  }
  .legal-prose :global(li) {
    margin-bottom: var(--space-2);
  }
  .legal-prose :global(a) {
    color: var(--color-brand-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-prose :global(a:hover) {
    color: var(--color-brand-dark);
  }
  .legal-prose :global(strong) {
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
  }
  .legal-prose :global(blockquote) {
    margin: var(--space-5) 0;
    padding: var(--space-4) var(--space-5);
    background: var(--color-mint);
    border-left: 3px solid var(--color-brand);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .legal-prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .legal-prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-line);
    margin-block: var(--space-8);
  }
  .legal-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-5);
    font-size: var(--text-sm);
  }
  .legal-prose :global(th),
  .legal-prose :global(td) {
    text-align: left;
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    vertical-align: top;
  }
  .legal-prose :global(th) {
    background: var(--color-cloud);
    font-weight: var(--weight-semibold);
  }
  .legal-prose :global(em) {
    color: var(--color-text-muted);
  }
</style>
