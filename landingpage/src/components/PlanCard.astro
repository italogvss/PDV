---
interface Props {
  nome: string;
  descricao: string;
  mensal: number;
  anual: number; // valor por mês no plano anual
  itens: string[];
  destaque?: boolean;
  badge?: string;
  ctaHref: string;
  ctaLabel?: string;
  revealDelay?: number;
}
const {
  nome, descricao, mensal, anual, itens,
  destaque = false, badge = 'Mais escolhido',
  ctaHref, ctaLabel = 'Começar teste grátis', revealDelay = 0,
} = Astro.props;
---

<article
  class:list={['plan-card', { featured: destaque }]}
  data-mensal={mensal}
  data-anual={anual}
  data-reveal
  style={`--reveal-delay: ${revealDelay}ms`}
>
  {destaque && <span class="plan-badge">{badge}</span>}
  <h3 class="plan-nome">{nome}</h3>
  <p class="plan-desc">{descricao}</p>

  <p class="plan-preco">
    <span class="plan-cifra">R$</span><span class="plan-amount">{mensal}</span><span class="plan-per">/mês</span>
  </p>
  <p class="plan-billing">cobrança mensal, cancela quando quiser</p>

  <ul class="plan-itens">
    {itens.map((i) => <li>{i}</li>)}
  </ul>

  <a href={ctaHref} class:list={['plan-cta', { 'btn-brand': destaque }]}>{ctaLabel}</a>
</article>

<style>
  .plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-6) var(--space-7);
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-base) var(--ease-spring), box-shadow var(--dur-base) var(--ease-out);
  }
  .plan-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .plan-card.featured {
    background:
      radial-gradient(130% 80% at 50% 0%, rgba(37, 207, 63, 0.12), transparent 62%),
      var(--color-card);
    border: 2px solid var(--color-brand);
    box-shadow: var(--shadow-md);
  }
  .plan-badge {
    position: absolute;
    top: calc(-1 * var(--space-3));
    left: 50%;
    transform: translateX(-50%);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-on-brand);
    background: var(--color-brand);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
  }
  .plan-nome { font-size: var(--text-2xl); }
  .plan-desc { font-size: var(--text-sm); color: var(--color-text-muted); min-height: 2.6em; }
  .plan-preco {
    font-family: var(--font-display);
    color: var(--color-ink);
    line-height: 1;
    margin-top: var(--space-2);
    display: flex;
    align-items: baseline;
    gap: 2px;
  }
  .plan-cifra { font-size: var(--text-2xl); color: var(--color-text-muted); }
  .plan-amount {
    font-size: var(--text-6xl);
    display: inline-block;
    transition: transform var(--dur-base) var(--ease-spring);
  }
  .plan-amount.flip { animation: amount-flip var(--dur-base) var(--ease-spring); }
  @keyframes amount-flip {
    0% { opacity: 0.2; transform: translateY(-0.18em); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .plan-per { font-family: var(--font-body); font-size: var(--text-base); color: var(--color-text-muted); }
  .plan-billing {
    font-size: var(--text-sm);
    color: var(--color-brand-deep);
    min-height: 1.4em;
    transition: opacity var(--dur-fast);
  }
  .plan-itens { display: flex; flex-direction: column; gap: var(--space-2); margin: var(--space-4) 0 var(--space-5); }
  .plan-itens li { position: relative; padding-left: var(--space-6); font-size: var(--text-base); color: var(--color-text); }
  .plan-itens li::before { content: '✓'; position: absolute; left: 0; color: var(--color-brand-dark); font-weight: var(--weight-bold); }
  .plan-cta {
    margin-top: auto;
    text-align: center;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    border: 1px solid var(--color-line-strong);
    transition: border-color var(--dur-fast), background-color var(--dur-fast), color var(--dur-fast), transform var(--dur-base) var(--ease-spring);
  }
  .plan-cta:not(.btn-brand):hover { border-color: var(--color-brand); color: var(--color-brand-deep); background: var(--color-mint); }
</style>
