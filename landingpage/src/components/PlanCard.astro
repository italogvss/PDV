---
import MeshGradient from './MeshGradient.astro';

interface Props {
  nome: string;
  descricao: string;
  mensal: string; // valor por mês na cobrança mensal (pt-BR, ex.: "29,99")
  anual: string; // valor TOTAL do plano anual, pago uma vez (ex.: "299,99")
  economia: string; // economia no anual vs. 12× o mensal (ex.: "59,89")
  itens: string[];
  destaque?: boolean;
  badge?: string;
  ctaHrefMensal: string; // destino do CTA no período mensal (?plano=<slug>-mensal)
  ctaHrefAnual: string; // destino do CTA no período anual (?plano=<slug>-anual)
  ctaLabel?: string;
  revealDelay?: number;
}
const {
  nome, descricao, mensal, anual, economia, itens,
  destaque = false, badge = 'Mais escolhido',
  ctaHrefMensal, ctaHrefAnual, ctaLabel = 'Começar teste grátis', revealDelay = 0,
} = Astro.props;
---

<article
  class:list={['plan-card', { featured: destaque, 'border-trail': destaque }]}
  data-mensal={mensal}
  data-anual={anual}
  data-economia={economia}
  data-reveal
  style={`--reveal-delay: ${revealDelay}ms`}
>
  {destaque && <MeshGradient class="plan-bg" speed={1.1} intensity={0.7} />}
  {destaque && (
    <span class="plan-badge">
      <svg class="plan-badge-star" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
        <path d="M12 2l2.6 6.9L21.5 12l-6.9 2.6L12 21.5l-2.6-6.9L2.5 12l6.9-2.6z" />
      </svg>
      {badge}
    </span>
  )}
  <h3 class="plan-nome">{nome}</h3>
  <p class="plan-desc">{descricao}</p>

  <p class="plan-preco">
    <span class="plan-cifra">R$</span><span class="plan-amount">{mensal}</span><span class="plan-per">/mês</span>
  </p>
  <p class="plan-billing">cobrança mensal, cancela quando quiser</p>
  <p class="plan-economia" hidden>
    <span class="plan-eco-tag">2 meses grátis</span>
    <span class="plan-eco-txt">você economiza R$ {economia} por ano</span>
  </p>

  <ul class="plan-itens">
    {itens.map((i) => <li>{i}</li>)}
  </ul>

  <a
    href={ctaHrefMensal}
    data-cta-mensal={ctaHrefMensal}
    data-cta-anual={ctaHrefAnual}
    class:list={['plan-cta', { 'btn-brand': destaque }]}
  >{ctaLabel}</a>
</article>

<style>
  .plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-6) var(--space-7);
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-base) var(--ease-spring), box-shadow var(--dur-base) var(--ease-out);
  }
  .plan-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .plan-card.featured {
    background:
      radial-gradient(150% 100% at 50% -8%, rgba(37, 207, 63, 0.18), transparent 58%),
      radial-gradient(120% 80% at 50% 108%, rgba(37, 207, 63, 0.08), transparent 60%),
      var(--color-card);
    border: 1.5px solid color-mix(in srgb, var(--color-brand) 45%, var(--color-line));
    box-shadow: var(--shadow-glow);
  }
  .plan-card.featured:hover { box-shadow: var(--shadow-glow), var(--shadow-md); }
  /* mesh-gradient animado dentro do card destaque — clipado pelo raio do card.
     Conteúdo sobe via z-index; o badge (absolute) atravessa a borda livremente. */
  .plan-bg {
    z-index: 0;
    border-radius: var(--radius-lg);
  }
  .plan-card.featured > :not(.plan-bg):not(.plan-badge) { position: relative; z-index: 1; }
  .plan-badge {
    position: absolute;
    top: calc(-1 * var(--space-4));
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-on-brand);
    background: linear-gradient(135deg, var(--color-brand-light), var(--color-brand) 52%, var(--color-brand-dark));
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    box-shadow:
      0 8px 20px -6px rgba(37, 207, 63, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    white-space: nowrap;
    z-index: 4;
  }
  .plan-badge-star {
    fill: currentColor;
    filter: drop-shadow(0 1px 1px rgba(8, 33, 13, 0.25));
    animation: badge-twinkle 2.8s var(--ease-spring) infinite;
  }
  @keyframes badge-twinkle {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
    50% { transform: scale(0.82) rotate(-12deg); opacity: 0.75; }
  }
  .plan-nome { font-size: var(--text-2xl); }
  .plan-desc { font-size: var(--text-sm); color: var(--color-text-muted); min-height: 2.6em; }
  .plan-preco {
    font-family: var(--font-display);
    color: var(--color-ink);
    line-height: 1;
    margin-top: var(--space-2);
    display: flex;
    align-items: baseline;
    gap: 2px;
  }
  .plan-cifra { font-size: var(--text-2xl); color: var(--color-text-muted); }
  .plan-amount {
    font-size: var(--text-6xl);
    display: inline-block;
    transition: transform var(--dur-base) var(--ease-spring);
  }
  .plan-amount.flip { animation: amount-flip var(--dur-base) var(--ease-spring); }
  @keyframes amount-flip {
    0% { opacity: 0.2; transform: translateY(-0.18em); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .plan-per { font-family: var(--font-body); font-size: var(--text-base); color: var(--color-text-muted); }
  .plan-billing {
    font-size: var(--text-sm);
    color: var(--color-brand-deep);
    min-height: 1.4em;
    transition: opacity var(--dur-fast);
  }
  .plan-economia {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
  .plan-economia[hidden] { display: none; }
  .plan-eco-tag {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-on-brand);
    background: linear-gradient(135deg, var(--color-brand-light), var(--color-brand) 55%, var(--color-brand-dark));
    border: 1px solid var(--color-brand-light);
    box-shadow:
      0 3px 10px -3px rgba(37, 207, 63, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
  }
  .plan-eco-txt { font-size: var(--text-sm); color: var(--color-text-muted); }
  .plan-itens { display: flex; flex-direction: column; gap: var(--space-2); margin: var(--space-4) 0 var(--space-5); }
  .plan-itens li { position: relative; padding-left: var(--space-6); font-size: var(--text-base); color: var(--color-text); }
  .plan-itens li::before { content: '✓'; position: absolute; left: 0; color: var(--color-brand-dark); font-weight: var(--weight-bold); }
  .plan-cta {
    margin-top: auto;
    text-align: center;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    border: 1px solid var(--color-line-strong);
    transition: border-color var(--dur-fast), background-color var(--dur-fast), color var(--dur-fast), transform var(--dur-base) var(--ease-spring);
  }
  .plan-cta:not(.btn-brand):hover { border-color: var(--color-brand); color: var(--color-brand-deep); background: var(--color-mint); }
</style>
