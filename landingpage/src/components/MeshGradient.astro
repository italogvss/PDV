---
/**
 * MeshGradient — fundo animado com "luzes" verdes que se movem suavemente.
 *
 * Porte do shader React (NLACE mesh gradient) para Astro/WebGL puro, retematizado
 * para a paleta do Ka$hing: o canvas é transparente (mostra o fundo da página) e
 * pinta apenas blobs de luz no verde de marca, que orbitam devagar.
 *
 * Cores lidas de tokens.css em runtime — nunca hardcodadas aqui.
 * Respeita prefers-reduced-motion (renderiza um único quadro estático).
 */
interface Props {
  /** Multiplicador de velocidade da animação. Padrão 1. */
  speed?: number;
  /** Intensidade/opacidade das luzes. Padrão 1. */
  intensity?: number;
  /** Quantidade de grain (textura). Padrão 0.5. */
  grain?: number;
  class?: string;
}
const { speed = 1, intensity = 1, grain = 0.5, class: className } = Astro.props;
---

<canvas
  class:list={['mesh-gradient', className]}
  data-speed={speed}
  data-intensity={intensity}
  data-grain={grain}
  aria-hidden="true"
></canvas>

<style>
  .mesh-gradient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    pointer-events: none;
  }
</style>

<script>
  type Params = { speed: number; intensity: number; grain: number };

  const VERT = 'attribute vec2 a; void main(){ gl_Position = vec4(a, 0.0, 1.0); }';

  const FRAG = [
    'precision highp float;',
    'uniform vec2 u_res; uniform float u_time; uniform float u_speed; uniform float u_intensity; uniform float u_grain;',
    'uniform vec3 u_glow; uniform vec3 u_glow2; uniform vec3 u_glow3;',
    'float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }',
    'float blob(vec2 uv, vec2 c, float r){ return smoothstep(r, 0.0, distance(uv, c)); }',
    'void main(){',
    '  vec2 uv = gl_FragCoord.xy / u_res.xy;',
    '  float t = u_time * 0.12 * u_speed;',
    '  vec2 p0 = vec2(0.22 + 0.16 * sin(t * 1.1), 0.32 + 0.18 * cos(t * 0.9));',
    '  vec2 p1 = vec2(0.80 + 0.14 * cos(t * 0.8), 0.26 + 0.16 * sin(t * 1.2));',
    '  vec2 p2 = vec2(0.58 + 0.20 * sin(t * 0.7), 0.76 + 0.14 * cos(t * 0.85));',
    '  vec2 p3 = vec2(0.16 + 0.15 * cos(t * 1.3), 0.70 + 0.12 * sin(t * 0.75));',
    '  float w0 = blob(uv, p0, 0.44) * 0.9;',
    '  float w1 = blob(uv, p1, 0.38) * 0.7;',
    '  float w2 = blob(uv, p2, 0.46) * 0.8;',
    '  float w3 = blob(uv, p3, 0.36) * 0.6;',
    '  float ws = w0 + w1 + w2 + w3 + 1e-4;',
    '  vec3 col = (u_glow * w0 + u_glow2 * w1 + u_glow * w2 + u_glow3 * w3) / ws;',
    '  col += (hash(uv * vec2(1031.0, 1973.0) + fract(u_time)) - 0.5) * 0.02 * u_grain;',
    '  float a = clamp((w0 + w1 + w2 + w3) * 0.55, 0.0, 0.72) * u_intensity;',
    '  gl_FragColor = vec4(col, a);',
    '}',
  ].join('\n');

  function hexToRgb(hex: string): [number, number, number] {
    let h = hex.trim().replace('#', '');
    if (h.length === 3) h = h.split('').map((c) => c + c).join('');
    const n = parseInt(h, 16);
    return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
  }

  function cssVar(name: string, fallback: string): string {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || fallback;
  }

  function initCanvas(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl', {
      antialias: true,
      alpha: true,
      premultipliedAlpha: false,
    });
    if (!gl) return;

    const params: Params = {
      speed: Number(canvas.dataset.speed ?? 1),
      intensity: Number(canvas.dataset.intensity ?? 1),
      grain: Number(canvas.dataset.grain ?? 0.5),
    };

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) console.error(gl.getShaderInfoLog(s));
      return s;
    };

    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aLoc = gl.getAttribLocation(prog, 'a');
    gl.enableVertexAttribArray(aLoc);
    gl.vertexAttribPointer(aLoc, 2, gl.FLOAT, false, 0, 0);

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
    gl.clearColor(0, 0, 0, 0);

    const uRes = gl.getUniformLocation(prog, 'u_res');
    const uTime = gl.getUniformLocation(prog, 'u_time');
    const uSpeed = gl.getUniformLocation(prog, 'u_speed');
    const uInt = gl.getUniformLocation(prog, 'u_intensity');
    const uGrain = gl.getUniformLocation(prog, 'u_grain');

    // Cores de marca — iguais nos temas claro/escuro, lidas uma vez.
    gl.uniform3fv(gl.getUniformLocation(prog, 'u_glow'), hexToRgb(cssVar('--color-brand', '#25cf3f')));
    gl.uniform3fv(gl.getUniformLocation(prog, 'u_glow2'), hexToRgb(cssVar('--color-brand-light', '#5ee074')));
    gl.uniform3fv(gl.getUniformLocation(prog, 'u_glow3'), hexToRgb(cssVar('--color-brand-deep', '#0e7d22')));

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.max(1, Math.floor(canvas.clientWidth * dpr));
      const h = Math.max(1, Math.floor(canvas.clientHeight * dpr));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
      }
    };

    const draw = (timeSec: number) => {
      resize();
      gl.viewport(0, 0, gl.drawingBufferWidth, gl.drawingBufferHeight);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform2f(uRes, gl.drawingBufferWidth, gl.drawingBufferHeight);
      gl.uniform1f(uTime, timeSec);
      gl.uniform1f(uSpeed, params.speed);
      gl.uniform1f(uInt, params.intensity);
      gl.uniform1f(uGrain, params.grain);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      draw(8); // quadro estático com as luzes já espalhadas
      window.addEventListener('resize', () => draw(8));
      return;
    }

    const t0 = performance.now();
    let raf = 0;
    const frame = () => {
      draw((performance.now() - t0) / 1000);
      raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);

    // Pausa quando o canvas sai da viewport (economia de bateria/GPU).
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting && !raf) raf = requestAnimationFrame(frame);
        else if (!e.isIntersecting && raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      }
    });
    io.observe(canvas);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.mesh-gradient').forEach(initCanvas);
</script>
