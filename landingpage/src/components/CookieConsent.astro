---
/**
 * Banner de consentimento de cookies (LGPD).
 * Barra fixa na base da tela, renderizada em todas as páginas (via Layout).
 * Só aparece enquanto o usuário não escolheu aceitar ou recusar cookies não
 * essenciais (Google Analytics). A escolha fica em localStorage e também
 * atualiza o Google Consent Mode (ver script inline de GA em Layout.astro)
 * através de `window.gtag('consent', 'update', ...)`.
 */
---

<div
  id="cookie-consent"
  class="cookie-consent"
  role="region"
  aria-label="Aviso de cookies"
  hidden
>
  <div class="cookie-card">
    <p class="cookie-text">
      Usamos cookies essenciais para o funcionamento do site e, mediante seu consentimento,
      cookies de análise (Google Analytics) para entender como você usa a Kashing. Saiba mais na 
      <a href="/politica-de-privacidade" class="cookie-link">Política de Privacidade</a> e nos 
      <a href="/termos-de-uso" class="cookie-link">Termos de Uso</a>.
    </p>
    <div class="cookie-actions">
      <button type="button" id="cookie-reject" class="cookie-btn cookie-btn-ghost">Recusar</button>
      <button type="button" id="cookie-accept" class="cookie-btn cookie-btn-brand">Aceitar</button>
    </div>
  </div>
</div>

<style>
  .cookie-consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 300; /* acima do ThemeToggle (200) e da navbar (100) */
    display: flex;
    justify-content: center;
    padding: var(--space-4) clamp(var(--space-4), 4vw, var(--space-6));
  }

  .cookie-card {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    width: 100%;
    max-width: 880px;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-5) var(--space-6);

    transition:
      transform var(--dur-slow) var(--ease-spring),
      opacity var(--dur-base) var(--ease-out);
  }

  .cookie-consent.is-leaving .cookie-card {
    transform: translateY(24px);
    opacity: 0;
  }

  .cookie-text {
    flex: 1 1 320px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .cookie-link {
    color: var(--color-brand-deep);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .cookie-link:hover { color: var(--color-brand-dark); }
  :global(html[data-theme='dark']) .cookie-link { color: var(--color-brand-light); }

  .cookie-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    margin-left: auto;
  }

  .cookie-btn {
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-full);
    transition:
      transform var(--dur-base) var(--ease-spring),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .cookie-btn:active { transform: translateY(0) scale(0.97); }

  .cookie-btn-ghost {
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-line-strong);
  }
  .cookie-btn-ghost:hover {
    border-color: var(--color-brand);
    color: var(--color-brand-deep);
    background: var(--color-mint);
  }
  :global(html[data-theme='dark']) .cookie-btn-ghost:hover { color: var(--color-brand-light); }

  .cookie-btn-brand {
    color: var(--color-on-brand);
    background: var(--color-brand);
    box-shadow: 0 6px 16px -6px rgba(37, 207, 63, 0.6);
  }
  .cookie-btn-brand:hover {
    background: var(--color-brand-dark);
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -8px rgba(37, 207, 63, 0.7);
  }

  @media (max-width: 640px) {
    .cookie-card { flex-direction: column; align-items: stretch; }
    .cookie-text { flex: none; }
    .cookie-actions { margin-left: 0; }
    .cookie-btn { flex: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-card { transition: opacity var(--dur-fast) linear; }
    .cookie-consent.is-leaving .cookie-card { transform: none; }
    .cookie-btn-brand:hover { transform: none; }
  }
</style>

<script>
  const STORAGE_KEY = 'cookie-consent';
  const banner = document.getElementById('cookie-consent');
  const acceptBtn = document.getElementById('cookie-accept');
  const rejectBtn = document.getElementById('cookie-reject');

  const updateGaConsent = (granted: boolean) => {
    (window as any).gtag?.('consent', 'update', {
      analytics_storage: granted ? 'granted' : 'denied',
    });
  };

  const dismiss = () => {
    banner?.classList.add('is-leaving');
    banner?.addEventListener('transitionend', () => banner?.setAttribute('hidden', ''), {
      once: true,
    });
  };

  if (!localStorage.getItem(STORAGE_KEY)) {
    banner?.removeAttribute('hidden');
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'accepted');
    updateGaConsent(true);
    dismiss();
  });

  rejectBtn?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'rejected');
    updateGaConsent(false);
    dismiss();
  });
</script>
