# =============================================================
# Kashing - Template de variaveis de PRODUCAO
# Copie para .env.prod e preencha os valores reais. NUNCA commite o .env.prod.
# Subir: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# =============================================================

# -- Banco de dados (MySQL) -----------------------------------
DB_ROOT_PASSWORD=troque_me
DB_NAME=pdv

# -- Backend (.NET) -------------------------------------------
DB_CONNECTION_STRING=Server=db;Port=3306;Database=pdv;User=root;Password=troque_me;AllowPublicKeyRetrieval=True;SslMode=None;
# Minimo 32 caracteres aleatorios.
JWT_SECRET=troque_por_uma_string_aleatoria_de_no_minimo_32_chars
JWT_EXPIRES_HOURS=8
# Dominio/IP publico da VPS - sem barra no final.
FRONTEND_URL=http://seu-dominio-ou-ip
# Dominio publico da landing - libera CORS do /api/legal. Sem barra no final.
LANDING_URL=http://seu-dominio-ou-ip-da-landing

# -- Storage de objetos (Cloudflare R2) ------------------------
# __ vira chave aninhada (Storage:...) no ASP.NET Core.
# Em producao Endpoint e PublicEndpoint sao o mesmo valor (sem split interno/externo como no MinIO de dev).
Storage__Endpoint=<ACCOUNT_ID>.r2.cloudflarestorage.com
Storage__PublicEndpoint=<ACCOUNT_ID>.r2.cloudflarestorage.com
Storage__AccessKey=troque_me
Storage__SecretKey=troque_me
Storage__UseSSL=true
# R2 exige "auto" (diferente do "us-east-1" usado em dev/MinIO).
Storage__Region=auto

# -- Google Sign-In ---------------------------------------------
# Backend so valida o ID token - nao precisa de ClientSecret.
Authentication__Google__ClientId=seu_google_client_id

# -- Pagamentos (Stripe) ------------------------------------------
Stripe__ApiKey=sk_live_...
# Secret do endpoint de webhook (Dashboard > Developers > Webhooks).
Stripe__WebhookSecret=whsec_...
# Precos de producao (price_...), por slug de plano.
Stripe__Prices__essencial-mensal=price_...
Stripe__Prices__essencial-anual=price_...
Stripe__Prices__profissional-mensal=price_...
Stripe__Prices__profissional-anual=price_...

# -- Frontend (Vite) ------------------------------------------
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=seu_google_client_id
VITE_LANDING_URL=https://seu-dominio.com

# -- Landing page (Astro) --------------------------------------
# Embutidos no build estatico da landing (servico landingpage do compose).
APP_URL=https://app.seu-dominio.com
# Opcional - deixe vazio se nao houver Analytics.
GA_MEASUREMENT_ID=
PUBLIC_API_URL=https://app.seu-dominio.com/api
