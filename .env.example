# =============================================================
# Kashing - Template de variaveis de DESENVOLVIMENTO
# Copie para .env e preencha os valores. NUNCA commite o .env.
# Toda a stack roda no Docker: docker compose up
# =============================================================

# -- Banco de dados (MySQL) -----------------------------------
DB_ROOT_PASSWORD=troque_me
DB_NAME=pdv-ultra

# -- Backend (.NET) -------------------------------------------
# Server=db -> servico MySQL do compose. Database/Password iguais a DB_NAME/DB_ROOT_PASSWORD.
DB_CONNECTION_STRING=Server=db;Port=3306;Database=pdv-ultra;User=root;Password=troque_me;AllowPublicKeyRetrieval=True;SslMode=None;
# Minimo 32 caracteres aleatorios.
JWT_SECRET=troque_por_uma_string_aleatoria_de_no_minimo_32_chars
JWT_EXPIRES_HOURS=8
# URLs liberadas no CORS - sem barra no final.
FRONTEND_URL=http://localhost:5173
LANDING_URL=http://localhost:5174

# -- Storage de objetos (MinIO) --------------------------------
# __ vira chave aninhada (Storage:...) no ASP.NET Core.
MINIO_ROOT_USER=troque_me
MINIO_ROOT_PASSWORD=troque_me_min_8_chars
# Endpoint interno (backend -> minio) e publico (navegador -> host, usado nas presigned URLs).
Storage__Endpoint=minio:9000
Storage__PublicEndpoint=localhost:9000
Storage__AccessKey=troque_me
Storage__SecretKey=troque_me_min_8_chars
Storage__UseSSL=false
Storage__Region=us-east-1

# -- Google Sign-In ---------------------------------------------
# Backend so valida o ID token - nao precisa de ClientSecret.
Authentication__Google__ClientId=seu_google_client_id

# -- Pagamentos (Stripe) ------------------------------------------
Stripe__ApiKey=sk_test_...
# `stripe listen` imprime um whsec_ efemero a cada sessao - cole aqui e reinicie a API.
Stripe__WebhookSecret=whsec_...
# Precos criados por .claude/stripe-bootstrap/bootstrap.ps1.
Stripe__Prices__essencial-mensal=price_...
Stripe__Prices__essencial-anual=price_...
Stripe__Prices__profissional-mensal=price_...
Stripe__Prices__profissional-anual=price_...

# -- Frontend (Vite) ------------------------------------------
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=seu_google_client_id
VITE_LANDING_URL=http://localhost:5174
